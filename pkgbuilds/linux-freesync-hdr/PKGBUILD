# Maintainer: Confined <https://github.com/Confined->
pkgbase=linux-freesync-hdr
pkgver=7.3.rc6
pkgrel=2
pkgdesc='Linux with FreeSync HDR mode support (amdgpu, rebased onto 7.3-rc6)'
url='https://github.com/Confined-/hyprland-freesync'
arch=(x86_64)
license=(GPL-2.0-only)
makedepends=(
  bc cpio gettext libelf pahole perl python tar xz zstd
)
options=('!strip')
_srcname=linux-7.3-rc6
source=(
  "https://git.kernel.org/torvalds/t/linux-7.3-rc6.tar.gz"
  # (mirror if kernel.org is slow: https://github.com/torvalds/linux/archive/v7.3-rc6.tar.gz)
  0001-amdgpu_dm-send-FreeSync-packets-on-DP.patch
  0002-amdgpu_dm-VSDB-in-CEA-extensions.patch
  0003-drm-amdgpu-FreeSync-HDR-Mode-property.patch
  linux-freesync-hdr.preset
)
# Run `updpkgsums` after reviewing, or keep SKIP for the upstream tarball.
sha256sums=('SKIP'
            'f8f18ce566138c7db466864f87310326cfdae0f25d04c86eadf4be5d7fb95577'
            '020b7659f01b713f6023cd23ae81a0129b9201c1649911ef7b782a6dfeca7ff6'
            'e0a332adc94f5ca8899d7789e9d7864540f97a8fe8892f5115cd8942dfa668e8'
            'SKIP')

export KBUILD_BUILD_HOST=archlinux
export KBUILD_BUILD_USER=$pkgbase
export KBUILD_BUILD_TIMESTAMP="$(date -Ru${SOURCE_DATE_EPOCH:+d @$SOURCE_DATE_EPOCH})"

prepare() {
  cd $_srcname

  echo "Applying FreeSync HDR patches..."
  for p in "$srcdir"/000*.patch; do
    patch -Np1 < "$p"
  done

  # Reuse the running kernel's config when available, else fall back to defconfig.
  if [[ -r /proc/config.gz ]]; then
    echo "Using /proc/config.gz as base config"
    zcat /proc/config.gz > .config
  else
    echo "No /proc/config.gz, falling back to defconfig"
    make defconfig
  fi

  # Hard requirements of this patch set.
  ./scripts/config -e DRM -e DRM_AMDGPU

  make olddefconfig

  make -s kernelrelease > version
  echo "Prepared $pkgbase $(<version)"
}

build() {
  cd $_srcname
  make -j$(nproc) all
}

_package() {
  pkgdesc="The $pkgdesc kernel and modules"
  depends=(coreutils kmod initramfs)
  optdepends=(
    'linux-firmware: firmware images needed for some devices'
    'wireless-regdb: to set the correct wireless channels of your country'
  )
  backup=("etc/mkinitcpio.d/$pkgbase.preset")

  cd $_srcname
  local kernver="$(<version)"
  local modulesdir="$pkgdir/usr/lib/modules/$kernver"

  echo "Installing modules..."
  make INSTALL_MOD_PATH="$pkgdir/usr" INSTALL_MOD_STRIP=1 modules_install

  # Remove the build symlink (headers package owns a real build dir).
  rm -f "$modulesdir"/build

  echo "Installing boot image..."
  install -Dm644 "$(make -s image_name)" "$pkgdir/boot/vmlinuz-$pkgbase"

  echo "Installing mkinitcpio preset..."
  install -Dm644 "$srcdir/$pkgbase.preset" "$pkgdir/etc/mkinitcpio.d/$pkgbase.preset"
}

_package-headers() {
  pkgdesc="Headers and scripts for building modules for the $pkgdesc kernel"
  depends=(pahole)

  cd $_srcname
  local kernver="$(<version)"
  local builddir="$pkgdir/usr/lib/modules/$kernver/build"

  echo "Installing headers..."

  # Install a set of headers, silently skipping patterns that match nothing
  # (source layouts vary between kernel versions).
  _install_headers() {
    local dest=$1; shift
    local pat f files=()
    shopt -s nullglob
    for pat in "$@"; do
      # shellcheck disable=SC2086
      for f in $pat; do
        files+=("$f")
      done
    done
    shopt -u nullglob
    if (( ${#files[@]} )); then
      mkdir -p "$dest"
      install -Dt "$dest" -m644 "${files[@]}"
    fi
  }

  install -Dt "$builddir" -m644 Makefile Module.symvers System.map version vmlinux .config
  install -Dt "$builddir/kernel" -m644 kernel/Makefile
  install -Dt "$builddir/arch/x86" -m644 arch/x86/Makefile
  cp -t "$builddir" -a scripts

  # required when DEBUG_INFO_BTF is enabled
  if [[ -x tools/bpf/resolve_btfids/resolve_btfids ]]; then
    install -Dt "$builddir/tools/bpf/resolve_btfids" tools/bpf/resolve_btfids/resolve_btfids
  fi

  _install_headers "$builddir/drivers/md" "drivers/md/*.h"
  _install_headers "$builddir/net/mac80211" "net/mac80211/*.h"
  _install_headers "$builddir/drivers/media/i2c" "drivers/media/i2c/*.h"
  _install_headers "$builddir/drivers/media/usb/dvb-usb" "drivers/media/usb/dvb-usb/*.h"
  _install_headers "$builddir/drivers/media/dvb-frontends" "drivers/media/dvb-frontends/*.h"
  _install_headers "$builddir/drivers/media/tuners" "drivers/media/tuners/*.h"
  _install_headers "$builddir/fs/xfs" "fs/xfs/*.h"
  _install_headers "$builddir/mm" "mm/*.h"
  _install_headers "$builddir/fs/overlayfs" "fs/overlayfs/*.h"
  _install_headers "$builddir/security/selinux" "security/selinux/*.h"
  _install_headers "$builddir/security/smack" "security/smack/*.h"
  _install_headers "$builddir/security/apparmor" "security/apparmor/*.h"
  _install_headers "$builddir/io_uring" "io_uring/*.h"

  echo "Installing headers for asm, drm and misc subsystems..."
  cp -t "$builddir" -a include
  cp -t "$builddir/arch/x86" -a arch/x86/include
  install -Dt "$builddir/arch/x86/kernel" -m644 arch/x86/kernel/asm-offsets.s

  _install_headers "$builddir/drivers/firmware/efi" "drivers/firmware/efi/*.h"
  _install_headers "$builddir/drivers/firmware/efi/efi" "drivers/firmware/efi/efi/*.h"

  echo "Adding makefiles and kconfigs..."
  find . -name 'Makefile*' -o -name 'Kconfig*' | while read -r f; do
    mkdir -p "$builddir/$(dirname "$f")"
    cp "$f" "$builddir/$f"
  done

  echo "Removing unneeded files..."
  find "$builddir" -name '*.o' -delete
}

pkgname=("$pkgbase" "$pkgbase-headers")
for _p in "${pkgname[@]}"; do
  eval "package_$_p() {
    $(declare -f "_package${_p#$pkgbase}")
    _package${_p#$pkgbase}
  }"
done
